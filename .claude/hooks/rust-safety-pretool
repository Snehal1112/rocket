#!/usr/bin/env bash
# PreToolUse guard for Rocket Claude project settings.

set -euo pipefail

payload="$(cat)"

emit_deny() {
  local reason="$1"
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PreToolUse",\n    "permissionDecision": "deny",\n    "permissionDecisionReason": "%s"\n  }\n}\n' "$reason"
  exit 2
}

# Allow standard developer workflow git commands (commit, add, status, etc.).
# Block programmatic git shell-outs that should use libgit2 instead.
if echo "$payload" | grep -Eq 'run_in_terminal|send_to_terminal|Bash'; then
  cmd=$(echo "$payload" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('command',''))" 2>/dev/null || true)
  if echo "$cmd" | grep -Eq '(^|[[:space:];|&`$(])git[[:space:]]'; then
    if ! echo "$cmd" | grep -Eq '^\s*git (commit|add|status|log|diff|push|pull|fetch|stash|tag|branch|checkout|restore|reset|rebase|merge|show|describe|rev-parse|config|remote)'; then
      emit_deny "Blocked: use git2-backed project services, not git CLI shell-outs."
    fi
  fi
fi

# Block the forbidden Rust pattern in edit payloads.
BANNED="unwr"
BANNED="${BANNED}ap()"
if echo "$payload" | grep -Eq 'apply_patch|create_file|Write|Edit'; then
  if echo "$payload" | grep -Eq '\.rs"|\.rs\b'; then
    if echo "$payload" | grep -qF "$BANNED"; then
      emit_deny "Blocked: ${BANNED} in Rust edit. Use DomainResult and explicit error mapping."
    fi
  fi
fi

exit 0
