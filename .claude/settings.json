{
	"worktree": {
		"baseRef": "head"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "bash /home/numericlabs/data/rocket/rocket/.claude/hooks/rust-safety-pretool"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "h=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/harness/hooks/bash-guard\"; if [ -f \"$h\" ]; then bash \"$h\"; fi"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "h=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/harness/hooks/commit-gate\"; if [ -f \"$h\" ]; then bash \"$h\"; fi",
						"timeout": 600
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(tools/factory/target/debug/factory:*)",
			"Bash(cargo build -j4 --manifest-path tools/factory/Cargo.toml:*)"
		],
		"deny": [
			"Bash(cargo test --workspace:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)"
		]
	}
}