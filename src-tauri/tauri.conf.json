{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rocket",
  "version": "1.3.0",
  "identifier": "com.numericlabs.rocket",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rocket",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src blob:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQzQzMDk2NDNFNzI0RkEKUldUNkpPZERsakRFSVdjKzFLU2lnbG1RUGpnOWdvOWQyZllEczVQN3lyVEgybGdDL0lqT0ZIdGEK",
      "endpoints": [
        "https://github.com/Snehal1112/rocket/releases/latest/download/latest.json"
      ]
    }
  }
}
